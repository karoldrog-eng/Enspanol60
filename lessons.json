ía completo", "phrases": [{"es": "Primero voy al hotel", "pl": "Najpierw jadę do hotelu"}, {"es": "Después quiero comer", "pl": "Potem chcę zjeść"}, {"es": "Por la tarde voy a pasear", "pl": "Po południu idę na spacer"}, {"es": "Por la noche vuelvo", "pl": "Wieczorem wracam"}]}, {"day": 56, "title": "Examen de viaje", "phrases": [{"es": "¿Podemos empezar?", "pl": "Możemy zacząć?"}, {"es": "Estoy listo", "pl": "Jestem gotowy"}, {"es": "¿Puede repetir la pregunta?", "pl": "Czy może Pan/Pani powtórzyć pytanie?"}, {"es": "Quiero intentarlo otra vez", "pl": "Chcę spróbować ponownie"}]}, {"day": 57, "title": "Repaso final", "phrases": [{"es": "¿Cómo se dice en español?", "pl": "Jak to się mówi po hiszpańsku?"}, {"es": "No recuerdo la palabra", "pl": "Nie pamiętam słowa"}, {"es": "Voy a intentarlo", "pl": "Spróbuję"}, {"es": "Ahora lo entiendo", "pl": "Teraz rozumiem"}]}, {"day": 58, "title": "Conversación libre", "phrases": [{"es": "¿Qué te gusta hacer?", "pl": "Co lubisz robić?"}, {"es": "¿Desde cuándo vives aquí?", "pl": "Od kiedy tu mieszkasz?"}, {"es": "¿Qué hiciste ayer?", "pl": "Co robiłeś wczoraj?"}, {"es": "¿Qué harás mañana?", "pl": "Co będziesz robić jutro?"}]}, {"day": 59, "title": "Examen final", "phrases": [{"es": "Quisiera reservar una mesa", "pl": "Chciałbym zarezerwować stolik"}, {"es": "Necesito llegar al aeropuerto", "pl": "Muszę dotrzeć na lotnisko"}, {"es": "¿Puede ayudarme con esto?", "pl": "Czy może Pan/Pani mi z tym pomóc?"}, {"es": "Muchas gracias, hasta pronto", "pl": "Dziękuję bardzo, do zobaczenia"}]}, {"day": 60, "title": "Próximos pasos", "phrases": [{"es": "Cada día entiendo más", "pl": "Każdego dnia rozumiem więcej"}, {"es": "Todavía necesito practicar", "pl": "Nadal muszę ćwiczyć"}, {"es": "Quiero seguir aprendiendo", "pl": "Chcę uczyć się dalej"}, {"es": "¡Hasta la próxima!", "pl": "Do następnego razu!"}]}]